      "panel": "磁磚工具",
      "buttons": [
        { "id": "tile.create_plan", "button": "CreateTilePlan", "label": "建立磁磚計畫", "interaction": "需要點選", "note": "選牆面、樓板後產生 3D 磁磚計畫" },
        { "id": "tile.preview_plan", "button": "TilePlanPreview", "label": "預覽磁磚計畫", "interaction": "會開視窗", "note": "預覽模式，調整方案與分區後確認套用" },
        { "id": "tile.toggle_grid", "button": "ToggleGridCommand", "label": "顯示/隱藏網格", "interaction": "直接執行", "note": "切換磁磚切割輔助綠線" },
        { "id": "tile.toggle_parts", "button": "TogglePartsVisibility", "label": "顯示/隱藏零件", "interaction": "直接執行", "note": "切換原主體與磁磚零件" },
        { "id": "tile.corner_join", "button": "CornerJoin", "label": "轉角接合", "interaction": "需要點選", "note": "點轉角的邊或逐一選 A／B 側零件" },
        { "id": "tile.make_slope", "button": "MakeSlope", "label": "製作斜率", "interaction": "會開視窗", "note": "平屋頂／樓板洩水坡度，浮動視窗選低邊" },
        { "id": "tile.align", "button": "AlignTile", "label": "對齊磁磚", "interaction": "需要點選", "note": "先選目標邊緣，再選磁磚邊緣" },
        { "id": "tile.copy_settings", "button": "CopyTileSettings", "label": "磁磚複製", "interaction": "需要點選", "note": "先點參考物件，再連續點目標，Esc 結束" },
        { "id": "tile.mirror_settings", "button": "MirrorTileSettings", "label": "磁磚鏡射", "interaction": "需要點選", "note": "同磁磚複製，但會先問翻轉方向" },
        { "id": "tile.roof_flip", "button": "ToggleRoofExteriorFlip", "label": "屋頂翻面", "interaction": "需要點選", "note": "切換預覽中選取的屋頂表面完成面朝向" },
        { "id": "tile.stairs", "button": "StairsTile", "label": "樓梯貼磚", "interaction": "會開視窗", "note": "選一座樓梯，浮動視窗預覽" },
        { "id": "tile.opening_trim", "button": "OpeningTrim", "label": "門窗收邊", "interaction": "會開視窗", "note": "點一面牆，收進該面門窗" },
        { "id": "tile.type_library", "button": "TileTypeLibrary", "label": "磁磚類型庫", "interaction": "會開視窗", "note": "管理磁磚類型，同步建立 Revit 類型與材質" },
        { "id": "tile.quantity", "button": "TileQuantity", "label": "磁磚數量計算", "interaction": "會開視窗", "note": "統計片數與面積，可匯出 Excel 或建明細表" }
      ]
    },
